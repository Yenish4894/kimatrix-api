# ============================================
# KIMates Backend - Environment Configuration
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================

# ─── Server Configuration ─────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=kimates_dev
DB_SSL=false

# ─── JWT Authentication ───────────────────────
# CRITICAL: Generate strong random secrets (min 32 chars)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_RANDOM_32_CHAR_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_32_CHAR_SECRET_HERE
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security Settings ────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_RESET_TTL_MIN=15

# ─── Redis (BullMQ + Rate Limiting) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── QR Submission Rate Limits ────────────────
# Per (company + mobile) combination
QR_SUBMIT_RATE_PER_MINUTE=10
QR_SUBMIT_RATE_PER_DAY=50
QR_MIN_RESUBMIT_INTERVAL_MIN=15
MAX_INVOICE_AMOUNT=10000000

# ─── Email (SMTP via Nodemailer) ──────────────
# For password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_EMAIL=no-reply@kimates.com
SMTP_FROM_NAME=KIMates

# ─── PayPal Integration ───────────────────────
# Get credentials from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ─── Application URLs ─────────────────────────
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:3000

# ============================================
# PRODUCTION SETTINGS (Reference)
# ============================================
# For production deployment, update these:
#
# NODE_ENV=production
# DB_SSL=true
# PAYPAL_MODE=live
# APP_BASE_URL=https://kimates.com
# FRONTEND_BASE_URL=https://kimates.com
# (The API is reverse-proxied under the main domain at /api. There is no
#  api.* subdomain — api.kimates.com does not resolve.)
#
# Security checklist:
# ✅ Strong JWT secrets (64+ chars)
# ✅ PostgreSQL SSL enabled
# ✅ Redis password set
# ✅ SMTP credentials secured
# ✅ PayPal live credentials
# ✅ CORS restricted to production domain
# ============================================
