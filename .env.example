# ============================================
# KIMates Backend - Environment Configuration
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to version control!
#
# Every key below is read by src/config/index.ts (or, for ATTACHMENT_DIR,
# src/config/uploads.ts). Keep the two in step when adding a key.
# ============================================

# ─── Server Configuration ─────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=kimates_dev
DB_SSL=false
# PEM root certificate, only for a provider on a private CA. Certificate validation is
# always on when DB_SSL=true; this is how you supply the root it should trust.
DB_CA_CERT=
# Connections in the app's pool.
DB_POOL_MAX=10
# Server-side cap on any one statement from the app (ms). Stops a runaway query from
# holding a pooled connection forever. 0 disables. Migrations always run uncapped.
DB_STATEMENT_TIMEOUT_MS=30000

# ─── JWT Authentication ───────────────────────
# CRITICAL: Generate strong random secrets (min 32 chars)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_RANDOM_32_CHAR_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_32_CHAR_SECRET_HERE
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security Settings ────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_RESET_TTL_MIN=15

# Email confirmation link lifetime. Much longer than a password reset on purpose —
# this is the first message a new customer receives, and a short window strands
# anyone who checks their inbox later. 1440 = 24 hours.
EMAIL_VERIFICATION_TTL_MIN=1440

# Fallback free-trial length in days. This only SEEDS the setting on a fresh install
# and acts as a safety net if app_settings can't be read — the live value is edited by
# an admin in the dashboard. The clock starts when the owner confirms their email, not
# at registration, so inbox latency never eats into the trial.
TRIAL_DURATION_DAYS=7

# REQUIRED IN PRODUCTION — the server refuses to boot without it (min 32 chars).
# Server-side pepper for the trial identity registry, which enforces "one free trial
# per email address and per phone number, ever". The table stores HMAC digests, never
# the identifiers themselves; this key is what makes them unrecoverable. A bare hash
# would not: every South African mobile number is ~10^8 candidates, so an unpeppered
# digest is brute-forced back to plaintext in minutes.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ROTATING IT ORPHANS EVERY EXISTING CLAIM — old digests can no longer be matched, so
# every previously-burned identifier silently becomes eligible for a second free
# trial. Treat it as permanent.
TRIAL_IDENTITY_PEPPER=

# ─── Redis (BullMQ + Rate Limiting + SMTP health) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── QR Submission Rate Limits ────────────────
# Per (company + mobile) combination
QR_SUBMIT_RATE_PER_MINUTE=10
QR_SUBMIT_RATE_PER_DAY=50
QR_MIN_RESUBMIT_INTERVAL_MIN=15
MAX_INVOICE_AMOUNT=10000000

# ─── Email (SMTP via Nodemailer) ──────────────
# Production uses Hostinger: smtp.hostinger.com, port 465, SMTP_SECURE=true.
# SMTP_FROM_EMAIL MUST be the same mailbox as SMTP_USER — Hostinger rejects a
# mismatched From, and that once silently stopped every email the platform sends.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@kimates.com
SMTP_PASS=your-mailbox-password
SMTP_FROM_EMAIL=info@kimates.com
SMTP_FROM_NAME=KIMates
# Hourly test email from SMTP_FROM_EMAIL to SMTP_USER (never an external address), so a
# suspended mailbox shows as "down" on the admin System status page within the hour.
# Unset → on in production, off elsewhere. "true"/"false" override.
SMTP_CANARY_ENABLED=

# ─── PayPal Integration ───────────────────────
# Get credentials from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ─── Signup Protection ────────────────────────
# Cloudflare Turnstile SECRET key (the site key goes in the frontend). OPTIONAL, in
# production too — the server boots without it.
#   empty → the human check is skipped entirely (feature-flagged until keys exist)
#   set   → every POST /api/auth/register/company must carry a valid `turnstileToken`;
#           if Cloudflare cannot be reached the signup is refused (fail closed).
# Get keys from: Cloudflare dashboard → Turnstile.
TURNSTILE_SECRET_KEY=

# ─── Data retention jobs (both irreversible) ──
# Nightly erasure of customer data for companies whose access ended longer ago than
# the retention window. Anything other than "true" leaves the job unscheduled.
EXPIRY_PURGE_ENABLED=false

# Nightly (03:40 UTC) removal of self-service signups whose owner never verified their
# email within 7 days and that have no payments, customers, comp, trial or admin
# origin. Anything other than "true" runs it in DRY-RUN mode: it only LOGS the
# candidates (company id, created date, email domain). Read a few nights of those logs
# before arming it — removal is a hard delete and cannot be undone.
UNVERIFIED_CLEANUP_ENABLED=false

# ─── Uploads ──────────────────────────────────
# Where bulk-email attachments are written. Defaults to ./uploads/bulk-email.
ATTACHMENT_DIR=

# ─── Application URLs ─────────────────────────
# Every link we email is built from this; must be https:// in production.
FRONTEND_BASE_URL=http://localhost:3000

# ============================================
# PRODUCTION SETTINGS (Reference)
# ============================================
# For production deployment, update these:
#
# NODE_ENV=production
# DB_SSL=true
# PAYPAL_MODE=live
# FRONTEND_BASE_URL=https://kimates.com
# (The API is reverse-proxied under the main domain at /api. There is no
#  api.* subdomain — api.kimates.com does not resolve.)
#
# Security checklist:
# ✅ Strong JWT secrets (64+ chars)
# ✅ PostgreSQL SSL enabled
# ✅ Redis password set
# ✅ SMTP credentials secured
# ✅ PayPal live credentials
# ✅ CORS restricted to production domain
# ============================================
