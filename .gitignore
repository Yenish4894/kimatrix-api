# ============================================
# KIMatrix Backend - .gitignore
# Node.js + TypeScript + PostgreSQL + Redis
# ============================================

# ─── Dependencies ───────────────────────────
node_modules/
jspm_packages/
package-lock.json.backup
yarn.lock.backup
pnpm-lock.yaml.backup

# ─── Build Output ───────────────────────────
dist/
build/
out/
*.tsbuildinfo
*.js.map

# ─── TypeScript ─────────────────────────────
*.tsbuildinfo
*.js
*.js.map
!scripts/*.js
!*.config.js
!eslint.config.js

# ─── Environment & Secrets ──────────────────
# CRITICAL: Never commit these!
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
.env.*.local
!.env.example

# Backup env files (if any)
.env.backup
.env.*.backup

# PayPal credentials (extra safety)
paypal-*.json
paypal-credentials.*

# JWT secrets (extra safety)
jwt-*.pem
jwt-*.key
*.pem
*.key
*.cert

# Database credentials backup
db-credentials.*
database.json

# ─── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
combined.log
error.log
access.log
application.log

# Pino logs
pino-*.log

# ─── Runtime / Cache ────────────────────────
.cache/
.parcel-cache/
.npm/
.turbo/
.eslintcache
.node_repl_history
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ─── Testing & Coverage ─────────────────────
coverage/
.nyc_output/
*.lcov
.vitest/
test-results/
junit.xml

# ─── Database ───────────────────────────────
# SQLite (if used for testing)
*.sqlite
*.sqlite3
*.db

# PostgreSQL dumps
*.sql
*.sql.gz
*.sql.bak
*.dump
*.backup

# Migration backups
migrations/*.bak
migrations/*.backup

# Database seeds (if sensitive)
seeds/*.production.ts
seeds/*.production.js

# ─── Redis ──────────────────────────────────
*.rdb
dump.rdb
appendonly.aof

# ─── Reports & Generated Files ──────────────
reports/
temp/
tmp/
pdfs/
exports/
uploads/

# Generated QR codes (if stored locally)
qr-codes/
static/qr/

# ─── IDE / Editor ───────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json
*.code-workspace

# WebStorm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# ─── OS Generated ───────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ─── Docker ─────────────────────────────────
.dockerignore.backup
docker-compose.override.yml
*.docker.log

# ─── CI/CD ──────────────────────────────────
.github/workflows/*.backup
.gitlab-ci.yml.backup

# Deployment scripts with secrets
deploy-*.sh
deploy.sh

# ─── Monitoring & Profiling ─────────────────
# Clinic.js / 0x
.clinic/
isolatescope-*.json
*.flamegraph
*.cpuprofile
*.heapsnapshot

# Sentry
.sentryclirc

# ─── Package Manager ────────────────────────
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─── Husky Git Hooks ────────────────────────
.husky/_/

# ─── Misc ───────────────────────────────────
# Backup files
*.bak
*.backup
*.old
*.orig
*.tmp

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Local notes
NOTES.md
TODO.local.md
SCRATCH.md
.notes/

# Local data fixtures (if sensitive)
fixtures/*.local.*
fixtures/*.production.*

# ============================================
# END OF .gitignore
# ============================================
